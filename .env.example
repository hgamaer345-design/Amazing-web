# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Speech-to-text provider (set ONE key, or use the mock) -----------------------------
# Auto-detected from the keys below when unset: assemblyai | deepgram | mock
TRANSCRIPTION_PROVIDER=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# AssemblyAI options
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com   # EU: https://api.eu.assemblyai.com
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2   # High / Ultra High
# ASSEMBLYAI_STANDARD_SPEECH_MODELS=universal-2

# Deepgram options
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# DEEPGRAM_MODEL=nova-3            # High / Ultra High
# DEEPGRAM_STANDARD_MODEL=nova-2
# DEEPGRAM_DIARIZE_MODEL=latest

# Mock provider (TRANSCRIPTION_PROVIDER=mock): simulated processing time
# MOCK_DELAY_MS=4000

# --- Server -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# PUBLIC_DIR=./dist/public
# MAX_UPLOAD_MB=500
# MAX_SPEAKERS=10
# TRUST_PROXY=false
# LOG_LEVEL=info

# Password-protect the app with HTTP basic auth (set both or neither)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# --- Quality modes -------------------------------------------------------------------------
# ULTRA_DAILY_LIMIT=3             # free Ultra High uses per visitor per day; "unlimited" removes it

# --- Background jobs ----------------------------------------------------------------------
# RUN_WORKER=true                 # false when running `npm run worker` separately
# WORKER_CONCURRENCY=2
# WORKER_POLL_INTERVAL_MS=1000
# PROVIDER_POLL_INTERVAL_MS=3000
# JOB_LEASE_MS=60000
# JOB_MAX_ATTEMPTS=3
# JOB_TIMEOUT_MINUTES=180
# DELETE_PROVIDER_DATA=true       # ask the provider to delete its copy after processing

# --- Development ----------------------------------------------------------------------------
# WEB_PORT=5173                   # Vite dev server
