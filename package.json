{
  "name": "speaker-transcriber",
  "version": "1.0.0",
  "private": true,
  "description": "Upload audio, transcribe it with speaker diarization, edit and export the speaker-separated transcript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts src/server/worker-main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/server --sourcemap",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node --enable-source-maps dist/server/index.js",
    "worker": "node --enable-source-maps dist/server/worker-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "music-metadata": "^12.3.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "coi-serviceworker": "0.1.7",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
